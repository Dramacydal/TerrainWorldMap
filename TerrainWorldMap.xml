<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\..\FrameXML\UI.xsd">
	<Frame name="TWMFrame" frameStrata="HIGH" toplevel="true" movable="true" resizable="true" parent="UIParent" inherits="TWMFrameTemplatePreBuilt, BackdropTemplate" hidden="true">
		<Size>
			<AbsDimension x="720" y="628"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset>
					<AbsDimension x="64" y="-64"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<!-- The map fills the whole frame; only a thin border is left (the
			backdrop, set in TWMFrame_OnLoadExtra). -->
			<Frame name="$parentViewFrame" enableMouse="true" inherits="TWMFrameViewTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="4" y="-4"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-4" y="4"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<!-- Control strip drawn over the top of the map; also the handle for
			moving the frame (the map itself pans on drag). Its frame level is
			lifted above the map's children in TWMFrame_OnLoadExtra. -->
			<Frame name="TWMFrameHeader" enableMouse="true">
				<Size>
					<AbsDimension x="1" y="35"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="TWMFrame">
						<Offset>
							<AbsDimension x="4" y="-1"/>
						</Offset>
					</Anchor>
					<Anchor point="TOPRIGHT" relativeTo="TWMFrame">
						<Offset>
							<AbsDimension x="-4" y="-1"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.55"/>
						</Texture>
					</Layer>
				</Layers>
				<Frames>
					<Button name="TWMFrameCloseButton" inherits="UIPanelCloseButton">
						<Anchors>
							<Anchor point="RIGHT">
								<Offset>
									<AbsDimension x="2" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<!-- The template's own handler hides the parent, which is now the header strip. -->
						<Scripts>
							<OnClick>
								TWMFrame:Hide();
							</OnClick>
						</Scripts>
					</Button>
					<Button name="TWMFrameLockButton">
						<Size>
							<AbsDimension x="32" y="32"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="TWMFrameCloseButton" relativePoint="LEFT">
								<Offset>
									<AbsDimension x="11" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								TWMFrame:ToggleLock();
							</OnClick>
						</Scripts>
						<NormalTexture name="$parentNorm"/>
						<PushedTexture name="$parentPush"/>
						<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
					</Button>
					<Button name="TWMFrameOptionsButton" inherits="UIPanelButtonTemplate" text="TWM_OPTIONSBUTTON">
						<Size>
							<AbsDimension x="90" y="20"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT" relativeTo="TWMFrameLockButton" relativePoint="LEFT">
								<Offset>
									<AbsDimension x="-6" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>
								TWMOption_Toggle();
							</OnClick>
						</Scripts>
					</Button>
					<!-- Blizzard_Menu dropdowns; their menus are set up in TWM_SetupDropdowns. -->
					<DropdownButton name="TWMFrameDropDown" inherits="WowStyle1DropdownTemplate">
						<Size>
							<AbsDimension x="170" y="24"/>
						</Size>
						<Anchors>
							<Anchor point="LEFT">
								<Offset>
									<AbsDimension x="4" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
					</DropdownButton>
					<DropdownButton name="TWMFrameDropDown2" inherits="WowStyle1DropdownTemplate">
						<Size>
							<AbsDimension x="170" y="24"/>
						</Size>
						<Anchors>
							<Anchor point="LEFT" relativeTo="TWMFrameDropDown" relativePoint="RIGHT">
								<Offset>
									<AbsDimension x="4" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
					</DropdownButton>
					<Button name="TWMFramePlayerJumpButton" text="TWM_PLAYERJUMP" inherits="UIPanelButtonTemplate">
						<Size>
							<AbsDimension x="108" y="24"/>
						</Size>
						<Anchors>
							<Anchor point="LEFT" relativeTo="TWMFrameDropDown2" relativePoint="RIGHT">
								<Offset>
									<AbsDimension x="4" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								self:RegisterEvent("VARIABLES_LOADED");
							</OnLoad>
							<OnEvent>
								TWMFramePlayerJumpButton_Update(self);
							</OnEvent>
							<OnClick>
								if(IsShiftKeyDown()) then
									TWMFramePlayerJumpButton_Toggle(self);
								else
									TWMFramePlayerJumpButton_Jump(self);
								end
							</OnClick>
							<OnMouseUp>
								TWMFramePlayerJumpButton_Update(self);
							</OnMouseUp>
							<OnShow>
								TWMFramePlayerJumpButton_Update(self);
							</OnShow>
							<OnEnter>
								GameTooltip:SetOwner(self, "ANCHOR_BOTTOM");
								GameTooltip:SetText(TWM_PLAYERJUMP);
								GameTooltip:AddLine(TWM_TOOLTIP_PLAYERJUMP, 1, 1, 1, true);
								GameTooltip:AddLine(TWM_TOOLTIP_PLAYERJUMP_FOLLOW, 1, 0.82, 0, true);
								GameTooltip:Show();
							</OnEnter>
							<OnLeave>
								GameTooltip:Hide();
							</OnLeave>
						</Scripts>
					</Button>
				</Frames>
				<Scripts>
					<OnLoad>
						self:RegisterForDrag("LeftButton");
					</OnLoad>
					<OnDragStart>
						local f = self:GetParent();
						f:GetScript("OnDragStart")(f);
					</OnDragStart>
					<OnDragStop>
						local f = self:GetParent();
						f:GetScript("OnDragStop")(f);
					</OnDragStop>
					<OnMouseWheel>
						local f = self:GetParent();
						f:SetZoom(f:GetZoom()+delta*24);
					</OnMouseWheel>
				</Scripts>
			</Frame>
			<Button name="TWMFrameResizeButton" parent="TWMFrame">
				<Size>
					<AbsDimension x="16" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetParent():GetFrameLevel() + TWM_WMO_FRAME_BAND + 40);
					</OnLoad>
					<OnMouseDown>
						TWMFrame:StartSizing("BOTTOMRIGHT");
					</OnMouseDown>
					<OnMouseUp>
						TWMFrame:StopMovingOrSizing();
						TWMFrame_OnResizeStop(TWMFrame, true);
					</OnMouseUp>
				</Scripts>
				<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
				<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
				<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				tinsert(UISpecialFrames,"TWMFrame");
				TWMFrame_Bootstrap(self);
				TWMFrame_OnLoadExtra();
			</OnLoad>
			<OnSizeChanged>
				TWMFrame_OnResizeStop(self);
			</OnSizeChanged>
		</Scripts>
	</Frame>

	<Frame name="TWMTooltip" frameStrata="TOOLTIP" hidden="true" parent="TWMFrame" inherits="TWMTooltipTemplate">
		<Anchors>
			<Anchor point="BOTTOMRIGHT" relativeTo="TWMFrameViewFrame" relativePoint="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
	</Frame>

	<Button name="TWMFOO" parent="TWMFrameViewFrame"> <!-- call me TWMFOO -->
		<Size>
			<AbsDimension x="24" y="24"/>
		</Size>
		<Anchors>
			<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="-8" y="16"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				self:SetFrameLevel(self:GetFrameLevel() + 4 + TWM_WMO_FRAME_BAND);
			</OnLoad>
			<OnClick>
				TWMFOO_OnClick(self);
			</OnClick>
		</Scripts>
		<NormalTexture file="Interface\Icons\Trade_Engineering"/>
		<PushedTexture file="Interface\Icons\Trade_Engineering"/>
		<DisabledTexture file="Interface\Icons\Trade_Engineering"/>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
	</Button>

	<Button name="TWMFrameZoomButton" parent="TWMFrameViewFrame">
		<Size>
			<AbsDimension x="24" y="24"/>
		</Size>
		<Anchors>
			<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT">
				<Offset>
					<AbsDimension x="8" y="8"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				self:SetFrameLevel(self:GetFrameLevel() + TWM_WMO_FRAME_BAND);
			</OnLoad>
			<OnClick>
				if(not TWMFrameZoomFrame:IsShown()) then
					TWMFrameZoomFrame:Show();
				else
					TWMFrameZoomFrame:Hide();
				end
			</OnClick>
		</Scripts>
		<NormalTexture file="Interface\Icons\INV_Misc_Spyglass_02"/>
		<PushedTexture file="Interface\Icons\INV_Misc_Spyglass_02"/>
		<DisabledTexture file="Interface\Icons\INV_Misc_Spyglass_02"/>
		<HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
	</Button>

	<!-- Only shown, always together with TWMFrameShowWMOOverlayButton below
	     (TerrainWorldMap.lua's TWM_UpdateOverlayButtons), when the current
	     map has BOTH real ADT terrain AND Twm_WMOTiles data; most maps
	     have only one or the other, so this pair is the exception, not the
	     default. Positioned above (see next CheckButton's anchor). Starts
	     below the control strip (TWMFrameHeader, 32 high) that covers the
	     top of the map. -->
	<CheckButton name="TWMFrameShowTerrainButton" parent="TWMFrameViewFrame" inherits="UICheckButtonTemplate" hidden="true">
		<Size>
			<AbsDimension x="24" y="24"/>
		</Size>
		<Anchors>
			<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT">
				<Offset>
					<AbsDimension x="-8" y="-40"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				self:SetFrameLevel(self:GetFrameLevel() + 4 + TWM_WMO_FRAME_BAND);
				_G[self:GetName().."Label"]:SetText(TWM_OPTIONS_SHOW_TERRAIN);
			</OnLoad>
			<OnClick>
				TWMFrameShowTerrainButton_OnClick(self);
			</OnClick>
		</Scripts>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentLabel" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Size>
						<AbsDimension x="150" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="RIGHT" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- Only shown, always together with TWMFrameShowTerrainButton above;
	     see its own comment. Anchored below it, not independently to
	     the ViewFrame, so the pair always stacks correctly regardless of
	     either one's own visibility. -->
	<CheckButton name="TWMFrameShowWMOOverlayButton" parent="TWMFrameViewFrame" inherits="UICheckButtonTemplate" hidden="true">
		<Size>
			<AbsDimension x="24" y="24"/>
		</Size>
		<Anchors>
			<Anchor point="TOP" relativeTo="TWMFrameShowTerrainButton" relativePoint="BOTTOM">
				<Offset>
					<AbsDimension x="0" y="-4"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				self:SetFrameLevel(self:GetFrameLevel() + 4 + TWM_WMO_FRAME_BAND);
				_G[self:GetName().."Label"]:SetText(TWM_OPTIONS_SHOW_WMO_OVERLAY);
			</OnLoad>
			<OnClick>
				TWMFrameShowWMOOverlayButton_OnClick(self);
			</OnClick>
		</Scripts>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentLabel" inherits="GameFontHighlightSmall" justifyH="RIGHT">
					<Size>
						<AbsDimension x="150" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="RIGHT" relativePoint="LEFT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- Parented to TWMFrame itself, NOT TWMFrameViewFrame/TWMFrameZoomButton.
	     TWMFrameViewTemplate's OnLoad calls SetClipsChildren(true) on the map
	     canvas (so tiles/flight-path lines don't render past its edges), which
	     silently clipped this popup too when it lived inside that hierarchy
	     (its own height pushed most of it below the canvas's visible rect).
	     Anchored explicitly to TWMFrameZoomButton instead of relying on
	     parent-relative anchoring, since it's no longer that button's child. -->
	<Frame name="TWMFrameZoomFrame" parent="TWMFrame" inherits="TWMZoomTemplate" hidden="true">
		<Anchors>
			<Anchor point="BOTTOM" relativeTo="TWMFrameZoomButton" relativePoint="TOP">
				<Offset>
					<AbsDimension x="0" y="4"/>
				</Offset>
			</Anchor>
		</Anchors>
	</Frame>

</Ui>
