<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\..\FrameXML\UI.xsd">
	<Frame name="TWMFrame" frameStrata="HIGH" toplevel="true" movable="true" resizable="true" parent="UIParent" inherits="TWMFrameTemplatePreBuilt, BackdropTemplate" hidden="true">
		<Size>
			<AbsDimension x="539" y="628"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset>
					<AbsDimension x="64" y="-64"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<!-- ARTWORK, not BACKGROUND: needs to sit above the native backdrop's
			own BACKGROUND-layer fill (see TWMFrame_OnLoadExtra), since both
			are regions of this same frame ; same reason the map tiles moved
			to ARTWORK too (see TWMFrameTemplatePreBuilt in Templates.xml). -->
			<Layer level="ARTWORK">
				<Texture name="$parentPortrait" file="Interface\AddOns\TerrainWorldMap\images\Button">
                    <Size>
                        <AbsDimension x="64" y="64"/>
                    </Size>
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="6" y="-4"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
			</Layer>
			<!-- Border is now a tiled BackdropTemplate (set in TWMFrame_OnLoadExtra)
			instead of these fixed-size corner images, since fixed art can't stretch
			and this frame is now resizable. -->
			<Layer level="BORDER">
			</Layer>
			<Layer level="OVERLAY">
				<FontString name="$parentName" inherits="GameFontHighlight" text="TWM_TITLE">
					<Size>
						<AbsDimension x="256" y="12"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="1" y="-17"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- Anchor set in Lua (TWMFrame_OnLoadExtra), relative to the
				lock button itself, so it can never end up underneath it;
				a layer region here can't forward-reference a child Frame
				that's declared later in this same XML block. -->
				<FontString name="$parentVersion" inherits="GameFontHighlight" justifyH="RIGHT" text="TWM_VERSION">
					<Size>
						<AbsDimension x="112" y="12"/>
					</Size>
					<Color r="0.4" g="0.4" b="0.4"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="TWMFrameCloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="CENTER" relativeTo="TWMFrame" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="-20" y="-25"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel() + 4);
					</OnLoad>
				</Scripts>
			</Button>
			<Button name="TWMFrameLockButton">
				<Size>
					<AbsDimension x="32" y="32"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="TWMFrameCloseButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="11" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel() + 4);
					</OnLoad>
					<OnClick>
						TWMFrame:ToggleLock();
					</OnClick>
				</Scripts>
				<NormalTexture name="$parentNorm"/>
				<PushedTexture name="$parentPush"/>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD"/>
			</Button>
			<Frame name="$parentViewFrame" enableMouse="true" inherits="TWMFrameViewTemplate">
				<Anchors>
				    <Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="22" y="-74"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-22" y="22"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Button name="TWMFrameResizeButton" parent="TWMFrame">
				<Size>
					<AbsDimension x="16" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetParent():GetFrameLevel() + 10);
					</OnLoad>
					<OnMouseDown>
						TWMFrame:StartSizing("BOTTOMRIGHT");
					</OnMouseDown>
					<OnMouseUp>
						TWMFrame:StopMovingOrSizing();
						TWMFrame_OnResizeStop(TWMFrame, true);
					</OnMouseUp>
				</Scripts>
				<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
				<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
				<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
			</Button>
			<Button name="TWMFrameDropDown" inherits="UIDropDownMenuTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="58" y="-40"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						TWMFrameDropDown_OnLoad(self);
					</OnLoad>
					<OnEvent>
						TWMFrameDropDown_OnEvent(self, event);
					</OnEvent>
				</Scripts>
			</Button>
			<Button name="TWMFrameDropDown2" inherits="UIDropDownMenuTemplate">
				<!-- Repositioned live by TWMFrame_LayoutHeader (centered in the
				gap between TWMFrameDropDown and TWMFramePlayerJumpButton);
				this anchor is only the pre-layout fallback position. -->
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="235" y="-40"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						TWMFrameDropDown2_OnLoad(self);
					</OnLoad>
					<OnEvent>
						TWMFrameDropDown2_OnEvent(self, event);
					</OnEvent>
				</Scripts>
			</Button>
			<!-- Position overridden by TWMFrame_LayoutHeader, which keeps this
			grouped with the two dropdowns and centers the whole cluster under
			the frame's current width; this anchor is only the pre-layout
			fallback. -->
			<Button name="TWMFramePlayerJumpButton" text="TWM_PLAYERJUMP" inherits="UIPanelButtonTemplate">
				<Size>
					<AbsDimension x="108" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="TWMFrameDropDown2" relativePoint="RIGHT">
						<Offset>
							<AbsDimension x="8" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel() + 4);
						self:RegisterEvent("VARIABLES_LOADED");
					</OnLoad>
					<OnEvent>
						TWMFramePlayerJumpButton_Update(self);
					</OnEvent>
					<OnClick>
						if(IsShiftKeyDown()) then
							TWMFramePlayerJumpButton_Toggle(self);
						else
							TWMFramePlayerJumpButton_Jump(self);
						end
					</OnClick>
					<OnMouseUp>
						TWMFramePlayerJumpButton_Update(self);
					</OnMouseUp>
					<OnShow>
						TWMFramePlayerJumpButton_Update(self);
					</OnShow>
				</Scripts>
			</Button>
			<Button name="TWMFrameOptionsButton" inherits="UIPanelButtonTemplate" text="TWM_OPTIONSBUTTON">
				<Size>
					<AbsDimension x="108" y="18"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="TWMFrameLockButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="-6" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel() + 4);
					</OnLoad>
					<OnClick>
						TWMOption_Toggle();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				tinsert(UISpecialFrames,"TWMFrame");
				TWMFrame_Bootstrap(self);
				TWMFrame_OnLoadExtra();
			</OnLoad>
			<OnSizeChanged>
				TWMFrame_OnResizeStop(self);
			</OnSizeChanged>
		</Scripts>
	</Frame>

	<Frame name="TWMTooltip" frameStrata="TOOLTIP" hidden="true" parent="TWMFrame" inherits="TWMTooltipTemplate">
		<Anchors>
			<Anchor point="BOTTOMRIGHT" relativeTo="TWMFrameViewFrame" relativePoint="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
	</Frame>

	<Button name="TWMFOO" parent="TWMFrameViewFrame"> <!-- call me TWMFOO -->
		<Size>
			<AbsDimension x="24" y="24"/>
		</Size>
		<Anchors>
			<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT">
				<Offset>
					<AbsDimension x="-8" y="8"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Frame name="$parentDropDown" inherits="UIDropDownMenuTemplate" hidden="true">
				<Anchors>
					<Anchor point="TOP">
						<Offset>
							<AbsDimension x="-80" y="-35"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						TWMFOO_Init(self);
					</OnLoad>
				</Scripts>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				self:SetFrameLevel(self:GetFrameLevel() + 4);
			</OnLoad>
			<OnClick>
				TWMFOO_OnClick(self);
			</OnClick>
		</Scripts>
		<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
		<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
		<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
		<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
	</Button>

	<Button name="TWMFrameZoomButton" parent="TWMFrameViewFrame">
		<Size>
			<AbsDimension x="24" y="24"/>
		</Size>
		<Anchors>
			<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT">
				<Offset>
					<AbsDimension x="8" y="8"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Frame name="TWMFrameZoomFrame" inherits="TWMZoomTemplate" hidden="true">
				<Anchors>
					<Anchor point="TOP">
						<Offset>
							<AbsDimension x="0" y="-20"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnClick>
				if(not TWMFrameZoomFrame:IsShown()) then
					TWMFrameZoomFrame:Show();
				else
					TWMFrameZoomFrame:Hide();
				end
			</OnClick>
		</Scripts>
		<NormalTexture file="Interface\AddOns\TerrainWorldMap\images\MagButton-Up"/>
		<PushedTexture file="Interface\AddOns\TerrainWorldMap\images\MagButton-Down"/>
		<DisabledTexture file="Interface\AddOns\TerrainWorldMap\images\MagButton-Disabled"/>
		<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
	</Button>

</Ui>
