<Ui xmlns="http://www.blizzard.com/wow/ui/" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
	<Texture name="TWMMapTextureTemplate" virtual="true">
		<Size>
			<AbsDimension x="64" y="64"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset>
					<AbsDimension x="6" y="-4"/>
				</Offset>
			</Anchor>
		</Anchors>
	</Texture>

	<Frame name="TWMFrameTemplate" virtual="true">
		<Scripts>
			<OnLoad>
			    TWMFrame_Bootstrap(self);
			</OnLoad>
			<OnShow>
				if(TWMOption and TWMOption.Frames) then
					local o = TWMOption.Frames[self:GetName()];
					if(o.track) then
						TWMFramePlayerJumpButton_Seek(self, o.track);
					elseif(o.trackonshow) then
						 TWMFramePlayerJumpButton_Seek(self, o.trackonshow);
					end
				end
			</OnShow>
			<OnDragStart>
				if(TWMOption.Frames and not TWMOption.Frames[self:GetName()].Locked) then
					self:StartMoving();
					self.isMoving = true;
				end
			</OnDragStart>
			<OnDragStop>
				if(self.isMoving) then
					self:StopMovingOrSizing();
					self.isMoving = false;
				end
			</OnDragStop>
			<OnUpdate>
				if(self.OnUpdate) then
					self:OnUpdate(elapsed);
				end
			</OnUpdate>
			<OnEvent>
				self:OnEvent(event, ...);
			</OnEvent>
		</Scripts>
	</Frame>

	<Frame name="TWMFrameViewTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				self.lastoux = 0;
				self.lastouy = 0;
				-- Clips every child (tiles, flight-path lines, ...) to
				-- this frame's own rect at the GPU level -- tiles
				-- already clip themselves manually (see
				-- WorldMapOverlay.lua's DrawTiles), but FlightPaths.lua
				-- relies on this so a line to an off-screen flight
				-- master doesn't render past this view's own edges.
				if(self.SetClipsChildren) then
					self:SetClipsChildren(true);
				end
			</OnLoad>
			<OnEnter>
				self.inme = true;
			</OnEnter>
			<OnLeave>
				self.inme = false;
			</OnLeave>
			<OnDragStart>
				self.dragme = true;
				twm_lastdragx = nil;
				twm_lastdragy = nil;
				TWM_elapsed = 0;
			</OnDragStart>
			<OnDragStop>
				self.dragme = false;
				self:GetParent():UpdateDropDown2();
			</OnDragStop>
			<OnHide>
				self.dragme = false;
			</OnHide>
			<OnUpdate>
				if(self.dragme) then
					TWMFrameViewFrame_OnDrag(self);
				end
				if(self.inme and self:GetParent() == TWMFrame and TWMOption.ShowCursorCoords) then
					TWMFrameViewFrame_UpdateCursorCoord(self);
				end
				if(self.inpoint) then
					TWMFrameViewFrame_UpdatePointTooltip(self);
				end
				-- See FlightPaths.lua: polls whether Shift is held so
				-- flight-path lines can switch between straight and curved
				-- without waiting for a pan/zoom/hover event.
				if(TWM_FlightPaths_PollShiftKey) then
					TWM_FlightPaths_PollShiftKey();
				end
			</OnUpdate>
			<OnMouseWheel>
				self:GetParent():SetZoom(self:GetParent():GetZoom()+delta*24);
			</OnMouseWheel>
		</Scripts>
	</Frame>

