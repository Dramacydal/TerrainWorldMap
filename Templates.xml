	<Frame name="TWMZoomTemplate" virtual="true" inherits="BackdropTemplate">
		<Size>
			<AbsDimension x="48" y="72" />
		</Size>
		<Frames>
			<Button name="$parentPlusButton" inherits="UIPanelButtonTemplate" text="TWM_ZOOMIN">
				<Size>
					<AbsDimension x="24" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="11" y="-12"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						local p = self:GetParent():GetParent():GetParent():GetParent();
						p:SetZoom(p:GetZoom()+24);
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentMinusButton" inherits="UIPanelButtonTemplate" text="TWM_ZOOMOUT">
				<Size>
					<AbsDimension x="24" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentPlusButton" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="0" y="1"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						local p = self:GetParent():GetParent():GetParent():GetParent();
						p:SetZoom(p:GetZoom()-24);
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				self:SetBackdrop{
					bgFile = "Interface\\Tooltips\\UI-Tooltip-Background",
					edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
					tile = true,
					edgeSize = 16,
					tileSize = 16,
					insets = { left = 5, right = 5, top = 5, bottom = 5 },
				};
				self:SetBackdropBorderColor(1, 1, 1);
				self:SetBackdropColor(0, 0, 0, 1);
			</OnLoad>
		</Scripts>
	</Frame>

