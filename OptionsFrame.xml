<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/../../FrameXML/UI.xsd">
	<Frame name="YatlasOptionsFrame" hidden="true" toplevel="true" frameStrata="DIALOG" movable="true" enableMouse="true" parent="UIParent" inherits="BackdropTemplate">
		<Size>
			<AbsDimension x="420" y="384"/>
		</Size>
		<Anchors>
 			<Anchor point="CENTER" />
 		</Anchors>

		<Layers>
			<Layer level="ARTWORK">
				<Texture name="YatlasOptionsFrameHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
					<Size>
						<AbsDimension x="256" y="58"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="12"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString inherits="GameFontNormal" text="YATLAS_OPTIONS_TITLE">
					<Anchors>
						<Anchor point="TOP" relativeTo="YatlasOptionsFrameHeader">
							<Offset>
								<AbsDimension x="0" y="-14"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>

		<Frames>
			<CheckButton name="YatlasOptionsButtonEnable" inherits="UICheckButtonTemplate">
				<Size>
					<AbsDimension x="24" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="24" y="-29" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString inherits="GameFontHighlight" justifyH="LEFT" text="YATLAS_OPTIONS_ENABLEBUTTON">
							<Size>
								<AbsDimension x="275" y="16"/>
							</Size>
							<Anchors>
								<Anchor point="LEFT">
									<Offset>
										<AbsDimension x="24" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel() + 4);
						self:RegisterEvent("VARIABLES_LOADED");
					</OnLoad>
					<OnEvent>
						self:SetChecked(YatlasOptions.ShowButton);
					</OnEvent>
					<OnClick>
						if (self:GetChecked()) then
							YatlasOptions.ShowButton = true;
						else
							YatlasOptions.ShowButton = false;
						end
						YatlasButton_Update()
					</OnClick>
				</Scripts>
			</CheckButton>
			<CheckButton name="YatlasOptionsTrackOnShow" inherits="UICheckButtonTemplate">
				<Size>
					<AbsDimension x="24" y="24"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="24" y="-64" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString inherits="GameFontHighlight" justifyH="LEFT" text="YATLAS_OPTIONS_TRACKONSHOW">
							<Size>
								<AbsDimension x="275" y="16"/>
							</Size>
							<Anchors>
								<Anchor point="LEFT">
									<Offset>
										<AbsDimension x="24" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						self:SetFrameLevel(self:GetFrameLevel() + 4);
						self:RegisterEvent("VARIABLES_LOADED");
					</OnLoad>
					<OnEvent>
						local aframe = next(YatlasOptions.Frames);
						self:SetChecked(YatlasOptions.Frames[aframe].trackonshow ~= nil);
					</OnEvent>
					<OnClick>
						<!-- control all frames at once -->
						for h,v in pairs(YatlasOptions.Frames) do
							if(self:GetChecked()) then
								v.trackonshow = "player"
							else
								v.trackonshow = nil
							end
						end
					</OnClick>
				</Scripts>
			</CheckButton>

			<Frame name="YatlasOptionsFrameFrame" inherits="BackdropTemplate">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="24" y="-114" />
						</Offset>
					</Anchor>
					<Anchor point="TOPRIGHT">
						<Offset>
							<AbsDimension x="-24" y="-114" />
						</Offset>
					</Anchor>
				</Anchors>
				<Size>
					<AbsDimension y="226"/>
				</Size>
				<Scripts>
					<OnLoad>
						self:SetBackdrop{
							bgFile = "Interface\\ChatFrame\\ChatFrameBackground",
							edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border",
							tile = true,
							edgeSize = 16,
							tileSize = 16,
							insets = { left = 4, right = 4, top = 4, bottom = 4 },
						};
						self:SetBackdropColor(0,0,0)
					</OnLoad>
				</Scripts>
				<Frames>
					<Button name="YatlasOptionsFrameSelect" inherits="UIDropDownMenuTemplate">
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="10" y="-12"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								self:RegisterEvent("VARIABLES_LOADED");
							</OnLoad>
							<OnEvent>
								if(event == "VARIABLES_LOADED") then
									UIDropDownMenu_Initialize(self, YatlasOptionsFrameSelect_Initialize);
									UIDropDownMenu_SetSelectedID(self, 1);
									UIDropDownMenu_SetWidth(self, 150);
									YatlasOptionsFrame_Update();
								end
							</OnEvent>
						</Scripts>
					</Button>
					<Slider name="YatlasOptionsAlphaSlider" inherits="OptionsSliderTemplate">
						<Size>
							<AbsDimension x="180" y="16"/>
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="32" y="-78" />
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								self:SetFrameLevel(self:GetFrameLevel() + 4);
								_G[self:GetName().."Text"]:SetText(YATLAS_OPTIONS_ALPHA);
								_G[self:GetName().."High"]:SetText();
								_G[self:GetName().."Low"]:SetText();
								self:SetMinMaxValues(.1,1);
								self:SetValueStep(.05);
							</OnLoad>
							<OnValueChanged>
								local frame = YatlasOptionsFrameSelect.currFrame;
								frame:SetAlpha(YatlasOptionsAlphaSlider:GetValue());
								YatlasOptions.Frames[frame:GetName()].Alpha = YatlasOptionsAlphaSlider:GetValue();
							</OnValueChanged>
						</Scripts>
					</Slider>
					<Slider name="YatlasOptionsIconSizeSlider" inherits="OptionsSliderTemplate">
						<Size>
							<AbsDimension x="180" y="16"/>
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="32" y="-122" />
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								self:SetFrameLevel(self:GetFrameLevel() + 4);
								_G[self:GetName().."Text"]:SetText(YATLAS_OPTIONS_ICONSIZE);
								_G[self:GetName().."High"]:SetText();
								_G[self:GetName().."Low"]:SetText();
								self:SetMinMaxValues(8,36);
								self:SetValueStep(1);
							</OnLoad>
							<OnValueChanged>
								local frame = YatlasOptionsFrameSelect.currFrame;
								local v = YatlasOptionsIconSizeSlider:GetValue();
								if(YatlasOptions.Frames[frame:GetName()].IconSize ~= v) then
									YatlasOptions.Frames[frame:GetName()].IconSize = v;
								    YAPoints_Update(frame);
								end
							</OnValueChanged>
						</Scripts>
					</Slider>
				</Frames>
			</Frame>

			<Button name="YatlasOptionsFrameOkay" inherits="GameMenuButtonTemplate" text="OKAY">
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-13" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						PlaySound(SOUNDKIT.GS_TITLE_OPTION_OK);
						YatlasOptionsFrame:Hide()
					</OnClick>
				</Scripts>
			</Button>
		</Frames>

		<Scripts>
			<OnLoad>
				self:SetBackdrop{
					bgFile = "Interface\\DialogFrame\\UI-DialogBox-Background",
					edgeFile = "Interface\\DialogFrame\\UI-DialogBox-Border",
					tile = true,
					edgeSize = 32,
					tileSize = 32,
					insets = { left = 11, right = 12, top = 12, bottom = 11 },
				};
				UIPanelWindows[self:GetName()] = { area = "center", pushable = 0, whileDead = 1 };
				self:RegisterEvent("VARIABLES_LOADED");
			</OnLoad>
			<OnEvent>

			</OnEvent>
			<OnShow>
				
			</OnShow>
		</Scripts>
	</Frame>
</Ui>
